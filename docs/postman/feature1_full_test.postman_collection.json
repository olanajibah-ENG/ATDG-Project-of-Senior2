    {
      "name": "0. تسجيل الدخول",
      "description": "اكتب username و password بمتغيّرات المجموعة (Variables) قبل أول طلب.",
      "item": [
        {
          "name": "POST login",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/upm/login/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "upm",
                "login"
              ]
            },
            "description": "بيرجّع access و refresh. السكربت بيحفظ access بمتغيّر token، وكل الطلبات التانية بتستعمله.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const d = pm.response.json(); pm.collectionVariables.set(\"token\", d.access);",
                  "pm.test(\"token saved\", () => pm.expect(d.access).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. النسخ",
      "description": "مشروع demo3: 8 نسخ. الحالات new / modified / unchanged / deleted.",
